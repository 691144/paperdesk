{
  "id": "./",
  "name": "PaperDesk Freeboard",
  "short_name": "PaperDesk",
  "description": "An infinite, borderless desk for dumping thoughts, files, voice memos, web snapshots and tasks.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#F6F4EF",
  "theme_color": "#FFFFFF",
  "categories": ["productivity", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "New Text Note",
      "short_name": "Text Note",
      "description": "Create a new text note on the desk",
      "url": "./index.html?create=text",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Record Voice Memo",
      "short_name": "Voice Memo",
      "description": "Create and record a voice memo",
      "url": "./index.html?create=voice",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "New Checklist",
      "short_name": "Checklist",
      "description": "Create a new checklist on the desk",
      "url": "./index.html?create=checklist",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "New Reminder",
      "short_name": "Reminder",
      "description": "Set a new reminder on the desk",
      "url": "./index.html?create=alarm",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
